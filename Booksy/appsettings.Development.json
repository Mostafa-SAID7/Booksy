{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=BooksyDb;Username=postgres;Password=postgres"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5500",
      "http://localhost:5000",
      "https://localhost:5001"
    ]
  },
  "Stripe": {
    "SecretKey": "sk_test_YOUR_KEY_HERE",
    "PublishableKey": "pk_test_YOUR_KEY_HERE"
  },
  "JWT": {
    "Issuer": "BooksyAPI",
    "Audience": "BooksyClient",
    "SecretKey": "dev-secret-key-min-32-characters!dev-secret-key-min",
    "ExpiryMinutes": 60
  },
  "EmailSettings": {
    "SenderEmail": "noreply@booksy.local",
    "SenderName": "Booksy Support",
    "SmtpServer": "localhost",
    "Port": 1025,
    "UserName": "",
    "Password": "",
    "EnableSSL": false
  },
  "Security": {
    "PasswordPolicy": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true
    },
    "RateLimiting": {
      "PermitLimit": 1000,
      "WindowMinutes": 1
    }
  }
}
