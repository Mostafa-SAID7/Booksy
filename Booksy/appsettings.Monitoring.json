{
  "Monitoring": {
    "Enabled": true,
    "LogLevel": "Information",
    "Alerts": {
      "Enabled": true,
      "Thresholds": {
        "FailedAuthenticationAttempts": {
          "Count": 5,
          "TimeWindowMinutes": 5,
          "Severity": "High",
          "Enabled": true
        },
        "UnauthorizedAccessAttempts": {
          "Count": 10,
          "TimeWindowMinutes": 5,
          "Severity": "High",
          "Enabled": true
        },
        "RateLimitExceeded": {
          "Threshold": 150,
          "Severity": "Medium",
          "Enabled": true
        },
        "SlowEndpoints": {
          "ThresholdMs": 5000,
          "Severity": "Medium",
          "Enabled": true
        },
        "SlowDatabaseQueries": {
          "ThresholdMs": 1000,
          "Severity": "Low",
          "Enabled": true
        },
        "ExceptionRate": {
          "ErrorsPerMinute": 10,
          "Severity": "High",
          "Enabled": true
        },
        "SuspiciousActivity": {
          "Severity": "Critical",
          "Enabled": true
        }
      },
      "Channels": {
        "Email": {
          "Enabled": false,
          "Recipients": ["admin@booksy.com"],
          "MinimumSeverity": "High"
        },
        "Webhook": {
          "Enabled": false,
          "Url": "",
          "MinimumSeverity": "High"
        },
        "Slack": {
          "Enabled": false,
          "WebhookUrl": "",
          "Channel": "#alerts",
          "MinimumSeverity": "High"
        },
        "PagerDuty": {
          "Enabled": false,
          "IntegrationKey": "",
          "MinimumSeverity": "Critical"
        },
        "ApplicationInsights": {
          "Enabled": false,
          "InstrumentationKey": "",
          "MinimumSeverity": "Low"
        }
      }
    },
    "Metrics": {
      "Enabled": true,
      "CollectionIntervalSeconds": 60,
      "RetentionDays": 30,
      "Endpoints": {
        "TrackEndpointPerformance": true,
        "TrackDatabaseQueries": true,
        "TrackExceptions": true,
        "TrackAuthenticationEvents": true,
        "TrackAuthorizationEvents": true
      }
    },
    "AuditLogging": {
      "Enabled": true,
      "LogDataModifications": true,
      "LogAuthenticationEvents": true,
      "LogAuthorizationEvents": true,
      "LogAdminActions": true,
      "RetentionDays": 90
    },
    "HealthCheck": {
      "Enabled": true,
      "IntervalSeconds": 300,
      "Checks": {
        "Database": true,
        "Cache": true,
        "ExternalServices": true,
        "DiskSpace": true,
        "Memory": true
      }
    }
  }
}
